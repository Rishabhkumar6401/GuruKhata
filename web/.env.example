# Where the GuruKhata API runs (no trailing slash). Dev default: http://localhost:3000
# REQUIRED for `npm run build` (production) unless VITE_ALLOW_DEV_LOGIN=1.
VITE_API_URL=http://localhost:3000

# Google OAuth Web client ID. REQUIRED for `npm run build` (production) unless
# VITE_ALLOW_DEV_LOGIN=1. Leave empty in `npm run dev` to get the "Dev login"
# form instead (the API must then run with DEV_AUTH=1).
VITE_GOOGLE_CLIENT_ID=

# DEV / STAGING ONLY. Set to 1 to allow a build without the two values above and
# to show the name-only "Dev login" form in a built app. Never set it for real users.
# VITE_ALLOW_DEV_LOGIN=1
