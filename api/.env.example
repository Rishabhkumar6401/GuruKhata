# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Neon free tier). Include sslmode=require for Neon.
# Example: postgres://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/gurukhata?sslmode=require
# LEAVE EMPTY for local dev: the API then uses PGlite (real Postgres in WASM),
# stored in api/.pglite-data, with db/schema.sql applied automatically.
DATABASE_URL=

# Optional: where PGlite keeps its files when DATABASE_URL is empty
# (default api/.pglite-data; 'memory://' = throwaway in-memory DB).
# PGLITE_DATA_DIR=

# Local dev server port (optional, default 3000). Irrelevant on Lambda.
PORT=3000

# Google OAuth 2.0 Web client ID — used to verify Google ID tokens on POST /api/auth/google.
# From Google Cloud Console → APIs & Services → Credentials.
# Unset = POST /api/auth/google answers 500 with a clear error.
GOOGLE_CLIENT_ID=

# Secret for signing our own session JWTs (30-day expiry).
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Unset + DEV_AUTH=1 = a fixed, PUBLIC dev secret is used (loud warning, local only).
# Unset otherwise   = every auth route answers 500 until it is set.
# REQUIRED whenever DATABASE_URL is set: the server refuses to boot without it.
JWT_SECRET=

# 1 = enable POST /api/auth/dev { name } (name-only login, no Google). LOCAL ONLY — never in prod.
# The server refuses to boot with DEV_AUTH=1 when DATABASE_URL or AWS_LAMBDA_FUNCTION_NAME is set.
DEV_AUTH=

# Comma-separated Google `sub` ids that become role=admin on login (bootstrap admins).
ADMIN_GOOGLE_SUBS=

# Comma-separated dev-login names (case-insensitive) that become role=admin (DEV_AUTH only).
ADMIN_DEV_NAMES=

# Comma-separated browser origins allowed by CORS (default http://localhost:5173).
CORS_ORIGINS=http://localhost:5173

# 0 = silence the per-request log line (the test suite sets this).
# LOG_REQUESTS=0
